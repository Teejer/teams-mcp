# Build-time configuration for deploy/build.sh — copy to .env and fill in.
# These are Azure app registration IDENTIFIERS, not secrets. Safe to keep in
# a file; still git-ignored to allow per-machine values.
#
# The values below are EXAMPLES using the RFC 4122 "example" GUID
# (11111111-1111-1111-1111-111111111111) reserved for documentation.
# Replace both with the real values from your Entra ID app registration:
#   Portal -> Entra ID -> App registrations -> <your app>
#     - "Application (client) ID"  -> TEAMS_MCP_CLIENT_ID
#     - "Directory (tenant) ID"    -> TEAMS_MCP_TENANT_ID

# Azure Entra ID app registration: Application (client) ID
# Example: 11111111-1111-1111-1111-111111111111
TEAMS_MCP_CLIENT_ID=11111111-1111-1111-1111-111111111111

# Azure Entra ID: Directory (tenant) ID (GUID or domain name)
# Example GUID:   22222222-2222-2222-2222-222222222222
# Example domain: contoso.onmicrosoft.com
TEAMS_MCP_TENANT_ID=22222222-2222-2222-2222-222222222222

# Optional: pin the npm package version instead of "latest"
#TEAMS_MCP_VERSION=0.9.0

# Optional: container timezone
#TZ=US/Mountain
